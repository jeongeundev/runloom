        "text": "={{ $json.body.title }} — {{ $json.body.human_gate.status_label }} · {{ $json.body.human_gate.reason }}\n{{ $json.body.chain_url }}",
        "otherOptions": {}
      },
      "id": "770438aa-afd8-4090-bbf4-33b0a7b6b0b9",
      "name": "Slack",
