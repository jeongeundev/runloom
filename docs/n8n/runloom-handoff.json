          "id": "runloom-source-token",
          "name": "Runloom source token"
        }
      }
    },
    {
      "parameters": {
        "resume": "webhook",
        "httpMethod": "POST",
        "options": {}
      },
      "id": "9d35daad-d947-475b-a5f6-f418c91f06d3",
      "name": "Wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        440,
        0
      ],
      "webhookId": "3f854403-fa53-4782-9495-aa60ee38e6ec"
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
