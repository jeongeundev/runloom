# 셀프호스트 .env 원본 (ADR-0016). install.sh 가 이 파일을 deploy/selfhost/.env(0600)로 복사하고 비밀값을 채운다.
# WORKFLOW_MODE·WORKFLOW_DB_PATH·WORKFLOW_ARTIFACT_DIR·WORKFLOW_BACKUP_DIR 는 compose.yaml 이 고정하므로 여기 두지 않는다.
# 빈 값은 기본값(또는 기능 꺼짐)이다.

# 호스트 포트 — 127.0.0.1 에만 열린다 (compose 치환 전용, 컨테이너 안은 항상 8000)
WORKFLOW_PORT=8000
# 로그인 쿠키 서명 키 (비밀값, install.sh 가 생성). 바꾸면 모든 로그인이 풀린다
SESSION_SECRET=
# /login 에 넣는 로그인 토큰 (비밀값, install.sh 가 생성)
OPERATOR_TOKEN=
# 진단 API 토큰 (선택, 비밀값). 비면 진단 기능이 꺼진다 — compose 에 진단 API 는 없다
DIAG_API_TOKEN=
# 진단 API 주소 (선택, 진단 토큰이 있을 때만 쓴다)
DIAG_API_URL=
# 세션(워크스페이스)당 하루 실행 상한 (비면 10)
WORKFLOW_LIMIT_PER_SESSION_DAILY=
# 전체 하루 실행 상한 (비면 60)
WORKFLOW_LIMIT_GLOBAL_DAILY=
# 세션당 동시 진행 업무 상한 (비면 5)
WORKFLOW_LIMIT_ACTIVE_TASKS_PER_SESSION=
# 첨부 최대 바이트 (비면 1048576)
WORKFLOW_LIMIT_ATTACHMENTS_MAX_BYTES=
# 실행 결과를 알 수 없음(unknown)으로 볼 때까지의 초 (비면 120)
WORKFLOW_LIMIT_UNKNOWN_AFTER_SECONDS=
# 러너 heartbeat 끊김 판정 초 (비면 90)
WORKFLOW_LIMIT_HEARTBEAT_OFFLINE_SECONDS=
# n8n callback 허용 호스트 (콤마 구분, 비면 callback 없음)
WORKFLOW_CALLBACK_HOSTS=
# chain_url·task_url 앞에 붙는 공개 주소 (예: http://127.0.0.1:8000, 비면 null)
WORKFLOW_PUBLIC_URL=
# GitHub 업무 순환 저장소 한정 토큰 (선택, 비밀값). 비면 GitHub 연결이 꺼진다
WORKFLOW_GITHUB_TOKEN=
# GitHub 연결을 허용할 저장소 owner/name (콤마 구분)
WORKFLOW_GITHUB_REPOS=
