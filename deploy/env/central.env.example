# 중앙 웹/API·중앙 워커 공용 환경변수 — /etc/workflow/central.env 로 복사해 채우고 chmod 600.
# 키 목록은 src/workflow/server/settings.py 의 ENV_KEYS 와 같아야 한다 (tests/test_deploy_files.py).
# 비밀값은 여기(환경변수)에만 둔다. DB·로그·응답·템플릿에 넣지 않는다 (AGENTS.md CRITICAL).

# --- 저장 (ARCHITECTURE 실행 위치 표) ---
WORKFLOW_DB_PATH=/var/lib/workflow/central/db.sqlite
WORKFLOW_ARTIFACT_DIR=/var/lib/workflow/central/artifacts

# --- 비밀값: openssl rand -hex 32 로 각각 생성 ---
# 심사자 세션 쿠키 서명 (HMAC). 바꾸면 기존 세션이 모두 끊긴다.
SESSION_SECRET=
# 운영자 화면(/operator) 로그인 토큰
OPERATOR_TOKEN=
# 진단 API 호출 토큰. diag.env 의 DIAG_API_TOKEN 과 같은 값
DIAG_API_TOKEN=

# --- 진단 API 주소: 같은 VM 의 localhost. 외부 주소를 넣지 않는다 ---
DIAG_API_URL=http://127.0.0.1:8100

# --- 실행 상한 초기값 (ARCHITECTURE 배포·예산 절). 측정 후 조정 ---
WORKFLOW_LIMIT_PER_SESSION_DAILY=10
# 진단 서비스의 DIAG_GLOBAL_DAILY 와 같은 값 (ADR-0003: gpt-4.1 단가로 총액 안에 두는 값)
WORKFLOW_LIMIT_GLOBAL_DAILY=36
WORKFLOW_LIMIT_ACTIVE_TASKS_PER_SESSION=5
WORKFLOW_LIMIT_ATTACHMENTS_MAX_BYTES=1048576
WORKFLOW_LIMIT_UNKNOWN_AFTER_SECONDS=120
WORKFLOW_LIMIT_HEARTBEAT_OFFLINE_SECONDS=90
