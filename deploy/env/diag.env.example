# 진단 API·진단 워커 공용 환경변수 — /etc/workflow/diag.env 로 복사해 채우고 chmod 600.
# 키 목록은 src/diagnostic_demo/settings.py 의 ENV_KEYS 와 같아야 한다 (tests/test_deploy_files.py).
# OPENAI_API_KEY 는 진단 워커만 쓴다. 중앙(central.env)에는 넣지 않는다.

# --- 저장 (ARCHITECTURE 실행 위치 표). 도구 조회 이력(tool_trace)도 산출물로 여기 저장된다 ---
DIAG_DB_PATH=/var/lib/workflow/diag/db.sqlite
DIAG_ARTIFACT_DIR=/var/lib/workflow/diag/artifacts
# fixture 는 저장소 안(가상 자료). 백업 대상이 아니다
DIAG_FIXTURES_DIR=/opt/workflow/src/diagnostic_demo/fixtures

# --- 비밀값 ---
# central.env 의 DIAG_API_TOKEN 과 같은 값 (openssl rand -hex 32)
DIAG_API_TOKEN=
# OpenAI API 키. ADR-0003 확정 조건(키·계정·예산 확인) 후에만 채운다. 비우면 워커가 exit 2 로 멈춘다
OPENAI_API_KEY=

# --- 모델 (ADR-0003 확정). fake 는 테스트·로컬 e2e 전용이라 배포에 쓰지 않는다 ---
DIAG_MODEL=openai
DIAG_MODEL_ID=gpt-4.1-2025-04-14
DIAG_ALLOWED_WORKFLOWS=daily-report
# fake 대본의 턴당 지연(초). DIAG_MODEL=fake 일 때만 쓰이고 openai 면 무시. 비우면 0 (대본 재생 데모는 2.5)
DIAG_FAKE_TURN_SECONDS=

# --- 예산 (ADR-0006 총액 US$30, 90% 에서 새 접수 중단) ---
DIAG_BUDGET_USD=30
DIAG_BUDGET_STOP_RATIO=0.9
# 백만 토큰당 USD. gpt-4.1 은 입력 2.00 / 출력 8.00 (2026-09-20 확인). 배포 전 공식 가격 페이지에서 다시 확인한다.
# 비워 두면(0) 비용을 추정하지 못해 총액 상한이 동작하지 않는다 — 반드시 채운다.
DIAG_PRICE_INPUT_PER_M=
DIAG_PRICE_OUTPUT_PER_M=

# --- 진단 1회 상한과 하루 상한 (ARCHITECTURE 모델 호출 예산 표) ---
DIAG_MAX_CALLS=15
DIAG_MAX_INPUT_TOKENS=80000
DIAG_MAX_OUTPUT_TOKENS=8000
DIAG_TIMEOUT_SECONDS=300
# ADR-0003: gpt-4.1 1회 US$0.049 × 36회 × 15일 ≈ US$26.5 로 총액 상한 안
DIAG_GLOBAL_DAILY=36
