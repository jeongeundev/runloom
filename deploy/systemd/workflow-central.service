# 중앙 웹/API — ADR-0006. Caddy 가 127.0.0.1:8000 으로 프록시한다.
# 설치: deploy/install-vm.sh 가 /etc/systemd/system/ 에 복사한다. 비밀값은 /etc/workflow/central.env (0600) 에만.
[Unit]
Description=workflow central web/API (uvicorn, 127.0.0.1:8000)
After=network-online.target
Wants=network-online.target

[Service]
User=workflow
Group=workflow
WorkingDirectory=/opt/workflow
EnvironmentFile=/etc/workflow/central.env
ExecStart=/opt/workflow/venv/bin/python -m uvicorn workflow.server.app:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
