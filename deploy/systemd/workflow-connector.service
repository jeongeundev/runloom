# 연결 프로그램 — 공개 데모(ADR-0008)는 같은 VM 에서 대본 에이전트를 돌린다. PATH 앞의 deploy/bin 래퍼가 codex·claude
# 이름으로 workflow.scripted.* 를 띄운다. 실제 Codex/Claude 는 이 VM 에 없다. 셀프호스트 실사용은 운영자 Mac 의
# launchd(ADR-0006, deploy/launchd/)를 쓰고 이 유닛은 쓰지 않는다.
# 연결 토큰은 /var/lib/workflow/connector/token.json (0600) 에서 프로그램이 읽는다 — env 파일에 넣지 않는다.
# connect·register 는 DEPLOY.md 6 단계에서 같은 WORKFLOW_CONNECTOR_HOME 으로 먼저 한 번 실행한다.
[Unit]
Description=workflow local connector (scripted agents, public demo)
After=network-online.target workflow-central.service
Wants=network-online.target

[Service]
User=workflow
Group=workflow
WorkingDirectory=/opt/workflow
EnvironmentFile=/etc/workflow/connector.env
# 래퍼가 앞, venv 가 그다음: 검증 프로필(vp-pytest=python3 -m pytest -q)의 python3 가 pytest 가 설치된 venv([dev])를 찾는다
Environment=PATH=/opt/workflow/deploy/bin:/opt/workflow/venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/workflow/venv/bin/python -m workflow.connector run
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
