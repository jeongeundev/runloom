# 진단 워커 — OPENAI_API_KEY 는 이 프로세스의 env 파일에만 있다. 키가 없으면 exit 2 로 멈추므로
# Restart=always 가 반복된다: journalctl -u workflow-diag-worker 로 이유를 본다.
[Unit]
Description=workflow diagnostic demo worker (OpenAI Responses API)
After=network-online.target workflow-diag.service
Wants=network-online.target

[Service]
User=workflow
Group=workflow
WorkingDirectory=/opt/workflow
EnvironmentFile=/etc/workflow/diag.env
ExecStart=/opt/workflow/venv/bin/python -m diagnostic_demo.worker
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
