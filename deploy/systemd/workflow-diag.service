# 진단 API — localhost 전용. Caddy 뒤에 두지 않으며 중앙 워커만 호출한다 (ADR-0006).
[Unit]
Description=workflow diagnostic demo API (uvicorn, 127.0.0.1:8100, localhost only)
After=network-online.target
Wants=network-online.target

[Service]
User=workflow
Group=workflow
WorkingDirectory=/opt/workflow
EnvironmentFile=/etc/workflow/diag.env
ExecStart=/opt/workflow/venv/bin/python -m uvicorn diagnostic_demo.api.app:app --host 127.0.0.1 --port 8100
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
